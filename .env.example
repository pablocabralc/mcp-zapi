# ─────────────────────────────────────────────────────────────────────────────
# Z-API — credenciais da instancia (https://app.z-api.io)
# ─────────────────────────────────────────────────────────────────────────────

# ID da instancia (aparece na URL do painel e no card da instancia)
ZAPI_INSTANCE_ID=

# Token da instancia
ZAPI_INSTANCE_TOKEN=

# Token de seguranca da CONTA — enviado no header `Client-Token`.
# Painel > Seguranca > Token de seguranca da conta.
ZAPI_CLIENT_TOKEN=

# Opcional. Base da API; so mude se a Z-API indicar outro host.
# ZAPI_BASE_URL=https://api.z-api.io

# Opcional. Token de parceiro/integrador, header `Partner-Token`.
# Necessario apenas para as tools zapi_partner_*.
# ZAPI_PARTNER_TOKEN=

# Opcional. Instancias adicionais, selecionaveis pelo argumento `instanceAlias`
# de qualquer tool. JSON em uma unica linha:
# ZAPI_INSTANCES={"vendas":{"instanceId":"...","instanceToken":"...","clientToken":"..."},"suporte":{"instanceId":"...","instanceToken":"..."}}

# Opcional. Limita quais grupos de tools sao expostos (util porque sao 217 no
# total e alguns clientes MCP degradam com muitas tools).
# Grupos: instancia, mensagens, mensagens-interativas, chats-contatos, grupos,
#         comunidades, canais, status, catalogo-business, perfil-business,
#         webhooks, privacidade, mobile-seguranca, parceiro
# ZAPI_TOOL_GROUPS=instancia,mensagens,chats-contatos,grupos

# ─────────────────────────────────────────────────────────────────────────────
# OAuth 2.1 — autenticacao do proprio servidor MCP
# ─────────────────────────────────────────────────────────────────────────────

# Segredo HMAC que assina client_id, authorization codes e tokens.
# Minimo 32 caracteres. Gere com:  openssl rand -hex 32
OAUTH_JWT_SECRET=

# Credenciais da tela de login exibida no /oauth/authorize.
OAUTH_LOGIN_USERNAME=admin
OAUTH_LOGIN_PASSWORD=

# Opcional. URL publica do servidor, usada como `issuer` e `resource`.
# Na Vercel e detectada automaticamente; defina se usar dominio customizado.
# OAUTH_ISSUER=https://mcp-zapi.seudominio.com

# Opcional. Desliga o OAuth por completo. APENAS para desenvolvimento local.
# MCP_DISABLE_AUTH=true
